<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timer_notification" android:layout_width="match_parent"
    android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="32dp" android:layout_height="32dp"
        android:src="@mipmap/ic_launcher" android:contentDescription="喵的图书馆" />
    <Chronometer android:id="@+id/timer_time" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="12dp"
        android:textSize="24sp" android:textColor="?android:attr/textColorPrimary"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
